# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL for PDF download links (Zapier / Make.com integrations).
APP_URL="https://yourname-chainguard-ai.hf.space"

# CHAINGUARD_API_KEY: Secures /api/integrations/audit for Zapier/Make.com callers.
CHAINGUARD_API_KEY="cg_live_your_secret_key"

# FREE_MONTHLY_AUDITS: Summary audit quota per API key (default 30).
# FREE_MONTHLY_PDFS: Sealed PDF quota per API key (default 5).
